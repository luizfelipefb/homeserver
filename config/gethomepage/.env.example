# Homepage secrets. Referenced as {{HOMEPAGE_VAR_NAME}} in the yaml files and loaded
# into the container via env_file in stacks/applications.yml.
# Copy to .env and fill in the values. Keep values in single quotes if they
# contain spaces or special characters such as # or $.

# ============================================================
# Media
# ============================================================
# Audiobookshelf API token (Settings > Users > your user > API Tokens)
HOMEPAGE_VAR_AUDIOBOOKSHELF_KEY=
# Seerr API key (Settings > General > API Key)
HOMEPAGE_VAR_SEERR_KEY=
# Plex token (X-Plex-Token of the server owner)
HOMEPAGE_VAR_PLEX_KEY=
# Tautulli API key (Settings > Web Interface > API)
HOMEPAGE_VAR_TAUTULLI_KEY=

# ============================================================
# arr
# ============================================================
# API keys: Settings > General > Security in each app
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=

# ============================================================
# Network
# ============================================================
# AdGuard Home login
HOMEPAGE_VAR_ADGUARD_USERNAME=
HOMEPAGE_VAR_ADGUARD_PASSWORD=
# Traefik dashboard basic auth
HOMEPAGE_VAR_TRAEFIK_USERNAME=
HOMEPAGE_VAR_TRAEFIK_PASSWORD=
# qBittorrent WebUI (Options > WebUI > Authentication)
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=

# ============================================================
# Monitoring
# ============================================================
# Beszel login (the email you sign in with)
HOMEPAGE_VAR_BESZEL_USERNAME=
HOMEPAGE_VAR_BESZEL_PASSWORD=
# Grafana login
HOMEPAGE_VAR_GRAFANA_USERNAME=
HOMEPAGE_VAR_GRAFANA_PASSWORD=

# ============================================================
# Home
# ============================================================
# Home Assistant long-lived access token (Profile > Security)
HOMEPAGE_VAR_HOME_ASSISTANT_KEY=

# ============================================================
# Tools
# ============================================================
# Backrest login
HOMEPAGE_VAR_BACKREST_USERNAME=
HOMEPAGE_VAR_BACKREST_PASSWORD=
# CoinMarketCap API key (pro.coinmarketcap.com > API Keys)
HOMEPAGE_VAR_COIN_MARKET_CAP_KEY=

# ============================================================
# Weather
# ============================================================
# Latitude / longitude in decimal degrees, e.g. -19.9167 / -43.9345
HOMEPAGE_VAR_WEATHER_LATITUDE=
HOMEPAGE_VAR_WEATHER_LONGITUDE=
# weatherapi.com API key (dashboard > API Key)
HOMEPAGE_VAR_WEATHER_API_KEY=
