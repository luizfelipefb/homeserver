# Copy to .env in the repository root and fill in the values:  cp .env.example .env
# The Makefile loads it with `--env-file .env`. Never commit .env (it is git-ignored).
#
# - Do not `source` this file: UID is read-only in bash/zsh.
# - Wrap values in single quotes if they contain spaces or special characters
#   such as # or $ (e.g. bcrypt hashes).
# - Homepage has its own secrets in config/gethomepage/.env (see config/gethomepage/.env.example).

# ============================================================
# General
# ============================================================
# Timezone in tz database format, e.g. America/Sao_Paulo
TIMEZONE=
# Numeric user and group IDs the containers run as (run `id -u` and `id -g`)
UID=
GID=
# Numeric ID of the host's docker group (run `getent group docker | cut -d: -f3`)
DOCKER_GID=

# ============================================================
# Paths
# ============================================================
# Absolute path where each service keeps its data/config (one subfolder per service)
CONFIG=
# Absolute path of the downloads folder
DOWNLOADS=
# Absolute path of the media library
MEDIA=
# Absolute path used for Plex transcoding (fast disk or tmpfs recommended)
TRANSCODE=

# ============================================================
# Network
# ============================================================
# Base domain used for Traefik routes and wildcard certificates, e.g. example.com
DOMAIN=
# LAN IP of this server, used for published ports and allowed hosts
HOST_IP=

# ============================================================
# Cloudflare (tunnel, ddns and Traefik DNS challenge)
# ============================================================
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
# Cloudflare account email and API key (My Profile > API Tokens)
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=

# ============================================================
# Authentication
# ============================================================
# Tinyauth users, format: user:bcrypt_hash (comma-separated for several users)
TINYAUTH_USERS=
# Vaultwarden admin panel token (a long random string or an argon2 hash)
VAULTWARDEN_ADMIN_TOKEN=

# ============================================================
# Monitoring
# ============================================================
# Beszel hub public key and agent token (Beszel UI > Add system)
BESZEL_KEY=
BESZEL_TOKEN=
# InfluxDB initial admin account and API token
INFLUXDB_ADMIN_USERNAME=
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_TOKEN=
# Loki password
LOKI_PASSWORD=
# Speedtest Tracker app key
SPEEDTEST_APIKEY=

# ============================================================
# Applications
# ============================================================
# Karakeep NEXTAUTH secret (generate with: openssl rand -base64 36)
KARAKEEP_SECRET=
# Plex claim token, valid for 4 minutes only (https://plex.tv/claim)
PLEX_CLAIM=

# ============================================================
# Backups (restic / backrest)
# ============================================================
# Storage credentials and repository password used by backrest/restic
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=
